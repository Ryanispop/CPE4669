#!/bin/bash
#SBATCH --job-name="mpi_sort_scaling"
#SBATCH --output="mpi_sort_scalling.%j.%N.out"
#SBATCH --partition=compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=128
#SBATCH --mem=0
#SBATCH --account="slo106"
#SBATCH --time=00:30:00

# Use a fixed, sufficiently large value of N for all runs.
# Test rank counts: 1, 2, 4, 8, 16, 32, 64, 128.
# Run each configuration at least 3 times to obtain median Tp.

N=10000000
RANKS=(1 2 4 8 16 32 64 128)
TRIALS=3

echo "Problem size N : $N"
echo "Rank counts    : ${RANKS[*]}"
echo "Trials per rank: $TRIALS"
echo ""

for p in "${RANKS[@]}"; do
    echo "--- Benchmarking rank count p = $p ---"
    for trial in $(seq 1 $TRIALS); do
        echo "Trial $trial for p=$p:"
        srun -n "$p" ./mpi_sort "$N"
    done
    echo ""
done

echo "=================================================="
echo "All scaling runs completed."

